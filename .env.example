# Copy to .env and fill in only what you need. Never commit a filled .env.

# Required by `autopilot serve`; at least 16 characters.
AUTOPILOT_WEBHOOK_SECRET=

# Local paths
AUTOPILOT_HOME=.
# AUTOPILOT_DB=./var/autopilot.db

# Bind address. Keep loopback unless a reverse proxy terminates TLS.
AUTOPILOT_HOST=127.0.0.1
AUTOPILOT_PORT=8000

# Default: deterministic local provider, no network, $0.
AUTOPILOT_PROVIDER=fake

# Live provider requires every one of the next five values.
# AUTOPILOT_PROVIDER=openai_compatible
# AUTOPILOT_ALLOW_LIVE_PROVIDER=1
# AUTOPILOT_OPENAI_BASE_URL=https://api.example.invalid/v1
# AUTOPILOT_OPENAI_API_KEY=
# AUTOPILOT_DAILY_COST_LIMIT_USD=0.50
# AUTOPILOT_MONTHLY_COST_LIMIT_USD=5.00

# Optional: enables the GitHub adapter instead of the local fixture adapter.
# AUTOPILOT_GITHUB_TOKEN=

# Remote access (never combine with an empty admin token).
# AUTOPILOT_ALLOW_REMOTE=1
# AUTOPILOT_ADMIN_TOKEN=
